   }\n    },\n    {\n      \"column\": \"price\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 393.94188158915017,\n        \"min\": 36.29,\n        \"max\": 975.57,\n        \"num_unique_values\": 4,\n        \"samples\": [\n          36.29\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"user_id\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 12629839,\n        \"min\": 526763765,\n        \"max\": 555338553,\n        \"num_unique_values\": 4,\n        \"samples\": [\n          553942405\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"user_session\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 4,\n        \"samples\": [\n          \"3460ca9c-ade7-4e17-98c4-89e53015f270\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"price_segment\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 3,\n        \"samples\": [\n          \"$100-200\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["<class 'pandas.core.frame.DataFrame'>\n","RangeIndex: 395243 entries, 0 to 395242\n","Data columns (total 10 columns):\n"," #   Column         Non-Null Count   Dtype  \n","---  ------         --------------   -----  \n"," 0   event_time     395243 non-null  object \n"," 1   event_type     395243 non-null  object \n"," 2   product_id     395243 non-null  int64  \n"," 3   category_id    198340 non-null  float64\n"," 4   category_code  264651 non-null  object \n"," 5   brand          337575 non-null  object \n"," 6   price          395243 non-null  float64\n"," 7   user_id        395243 non-null  int64  \n"," 8   user_session   395243 non-null  object \n"," 9   price_segment  395243 non-null  object \n","dtypes: float64(2), int64(2), object(6)\n","memory usage: 30.2+ MB\n"]}]},{"cell_type":"markdown","source":["## Типы данных"],"metadata":{"id":"sLgYztb11cXx"}},{"cell_type":"markdown","source":["Для начала проверим соответствие типам данных.\n","Выявляем следующие расхождения между семантикой данных и их типами:\n","1. Самый первый столбец **event_time** является временной отметкой с часовым поясом, однако имеет тип данных строковый **object**. Это является проблемой, так как со строковыми значения нельзя выполнять операции, как с датами (например, разницу во времени). Его тип данных необходимо преобразовать в **datetime**\n","2. Столбец **category_id** имеет вещественный тип **float64**, однако все ID - целочисленные идентификаторы, и этот столбец должен иметь тип **int64**. Но корнем этой проблемы является наличие пропусков (NaN), которые не поддерживаются целочисленными типами. Оставим его как **float64**, так как планируем дальнейшую обработку пропусков."],"metadata":{"id":"IqNSGKx_hLmv"}},{"cell_type":"code","source":["# преобразовываем event_time к datetime типу с учетом смешанного формата и часовых поясов\n","df['event_time'] = pd.to_datetime(df['event_time'], format='mixed', errors='coerce', utc=True)\n","\n","# проверяем наличие артефактов и корректность типа данных\n","print(f'Количество пропущенных времён: {df['event_time'].isna().sum()}')\n","print(f'Тип данных event_time: {df['event_time'].dtype}')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ftL2hrpqqJVm","executionInfo":{"status":"ok","timestamp":1763397320362,"user_tz":-180,"elapsed":20568,"user":{"displayName":"Ирина Повышева","userId":"05766638751836373777"}},"outputId":"9daca842-f445-4ed3-ae2d-6040d86aa890"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["Количество пропущенных времён: 0\n","Тип данных event_time: datetime64[ns, UTC]\n"]}]},{"cell_type":"markdown","source":["## Пропуски значений"],"metadata":{"id":"eLqlu5d21j63"}},{"cell_type":"markdown","source":["Теперь разберемся с пропусками - наблюдаем их сразу в 3 столбцах: **category_id**, **category_code**, **brand**.\n","\n","В дальнейшем будем проводить анализ по категориям, для этого будем использовать **category_code**, так как ID в таком анализе не является информативным. Именно по этой причине обработку пропусков проведем только в этом столбце"],"metadata":{"id":"x05-Drv4aFNL"}},{"cell_type":"code","source":["# заменяем NaN значения в category_code на 'unknown'\n","df['category_code'] = df['category_code'].fillna('unknown')\n","\n","# посмотрим на рейтинг категорий, чтобы оценить значимость пропусков\n","print('ТОП-10 категорий:')\n","print(df['category_code'].value_counts().head(10))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"2NvmtUncjn0w","executionInfo":{"status":"ok","timestamp":1763397320399,"user_tz":-180,"elapsed":40,"user":{"displayName":"Ирина Повышева","userId":"05766638751836373777"}},"outputId":"6de51c08-2839-4e01-ecb1-3ec3a7d03cb3"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["ТОП-10 категорий:\n","category_code\n","unknown                             130592\n","electronics.smartphone               95179\n","electronics.clocks                   12484\n","computers.notebook                   11458\n","electronics.video.tv                 11081\n","electronics.audio.headphone          10483\n","apparel.shoes                         9152\n","appliances.environment.vacuum         8878\n","appliances.kitchen.refrigerators      8343\n","appliances.kitchen.washer             8028\n","Name: count, dtype: int64\n"]}]},{"cell_type":"markdown","source":["Получилось, что товары с неизвестной категорией являются наиболее популярными среди наших клиентов, что является огромной утечкой информации, но это мы подробнее будем рассматривать уже непосредственно в анализе."],"metadata":{"id":"0DnqXMDFetQa"}},{"cell_type":"markdown","source":["## Дубликаты"],"metadata":{"id":"Jbh31sG01ngM"}},{"cell_type":"markdown","source":["Перейдем к последнему этапу нашей очистки данных и поищем дубликаты. Будем искать полные логические дубликаты - когда совпадает время события, тип события, ID пользователя и ID товара:"],"metadata":{"id":"2ivwYUzFgRn-"}},{"cell_type":"code","source":["# проверяем дубликаты по расширенному ключу\n","duplicates_full = df[\n","    df.duplicated(subset=['user_id', 'event_time', 'product_id', 'event_type'], keep=False)\n","]\n","\n","print(f'Найдено дубликатов по (user_id, event_time, product_id, event_type): {len(duplicates_full):,} строк')\n","print(f'Уникальных пользователей с дубликатами: {duplicates_full['user_id'].nunique():,}')\n","\n","if len(duplicates_full) > 0:\n","    print('\\n📋 Пример дубликатов:')\n","    display(duplicates_full.head(6))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":531},"id":"ferHNbm_74wV","executionInfo":{"status":"ok","timestamp":1763397320646,"user_tz":-180,"elapsed":241,"user":{"displayName":"Ирина Повышева","userId":"05766638751836373777"}},"outputId":"9bff09cd-7cfd-4b94-f64b-102fd4251c5d"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["Найдено дубликатов по (user_id, event_time, product_id, event_type): 629 строк\n","Уникальных пользователей с дубликатами: 156\n","\n","📋 Пример дубликатов:\n"]},{"output_type":"display_data","data":{"text/plain":["                    event_time event_type  product_id   category_id  \\\n","725  2019-10-01 04:50:21+00:00       cart     1004777  2.053014e+18   \n","726  2019-10-01 04:50:21+00:00       cart     1004777  2.053014e+18   \n","729  2019-10-01 04:50:28+00:00       cart     1004777  2.053014e+18   \n","730  2019-10-01 04:50:28+00:00       cart     1004777  2.053014e+18   \n","7323 2019-10-02 06:18:05+00:00       cart     1801690  2.053014e+18   \n","7324 2019-10-02 06:18:05+00:00       cart     1801690  2.053014e+